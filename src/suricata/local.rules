alert icmp any any -> $HOME_NET any (msg:"LAB ICMP flood"; itype:8; threshold: type both, track by_src, count 20, seconds 5; classtype:attempted-dos; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Port scan"; flags:S; threshold: type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH brute-force"; flow:to_server; flags:S; threshold: type both, track by_src, count 3, seconds 60; classtype:attempted-admin; sid:1000004; rev:2;)
alert udp any any -> any 53 (msg:"LAB DNS tunnel"; threshold: type both, track by_src, count 10, seconds 10; classtype:bad-unknown; sid:1000005; rev:1;)
alert tcp any 4444 -> $HOME_NET any (msg:"LAB Reverse shell - port 4444 accepted"; flags:SA; classtype:trojan-activity; sid:1000006; rev:2;)
