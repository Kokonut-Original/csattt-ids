# 01 - Quet cong (nmap)
alert tcp any any -> $HOME_NET any (msg:"LAB Port scan"; flags:S; threshold: type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)
# 02 - Brute-force SSH (hydra)
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH brute-force"; flow:to_server; flags:S; threshold: type both, track by_src, count 3, seconds 60; classtype:attempted-admin; sid:1000002; rev:2;)
# 03 - ICMP flood
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP flood"; itype:8; threshold: type both, track by_src, count 20, seconds 5; classtype:attempted-dos; sid:1000003; rev:1;)
# 04 - DNS tunnel
alert udp any any -> any 53 (msg:"LAB DNS tunnel"; threshold: type both, track by_src, count 10, seconds 10; classtype:bad-unknown; sid:1000004; rev:1;)
# 05 - Reverse shell (cong 4444)
alert tcp any 4444 -> $HOME_NET any (msg:"LAB Reverse shell - port 4444 accepted"; flags:SA; classtype:trojan-activity; sid:1000005; rev:2;)
